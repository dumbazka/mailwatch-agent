# --- Neon (Postgres) ---
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/mailwatch?sslmode=require

# --- Gmail OAuth (local dev) ---
# Path to the OAuth client secrets file downloaded from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Desktop app).
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=credentials/gmail_oauth_client.json
# Where the user's OAuth token (after first-time interactive consent) is cached.
GOOGLE_OAUTH_TOKEN_FILE=credentials/gmail_token.json

# --- Gmail OAuth (production — Render/Railway/etc.) ---
# There's no file there, so paste the *contents* of the two files above as
# the value of these instead. Leave both unset for local dev — the FILE
# vars above take over automatically. See README "Deploying" section.
GOOGLE_OAUTH_CLIENT_SECRETS_JSON=
GOOGLE_OAUTH_TOKEN_JSON=

# --- Gemini / ADK ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Discord bot (Phase 4) ---
DISCORD_BOT_TOKEN=
DISCORD_CONFIRMATION_CHANNEL_ID=
DISCORD_REMINDERS_CHANNEL_ID=

# --- Inngest ---
# Leave unset for local dev against `inngest dev`; set both in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Polling ---
POLL_INTERVAL_MINUTES=5
